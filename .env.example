# Paytm Saathi Environment Configuration
# Copy the area environment files:
#   server/.env.example -> server/.env (or root .env)
#   agent/.env.example -> agent/.env
#   integrations/.env.example -> integrations/.env

# Server Settings
DATABASE_URL=sqlite:///./saathi.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./uploads
SCHEDULER_TICK_SECONDS=5

# Hero Merchant Phones (can be customized for live WhatsApp tests)
HERO_PHONE_RAHUL=+919000000001
HERO_PHONE_MEENA=+919000000002
HERO_PHONE_SUNIL=+919000000003
HERO_PHONE_FARIDA=+919000000004
HERO_PHONE_VIKRAM=+919000000005
HERO_PHONE_POOJA=+919000000006

# LLM configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
