# Copy this to agent/.env and fill in the values
# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=8.0
LLM_CACHE=off

# Limits
MAX_CONTACT_ATTEMPTS=3
MAX_ACTIVATION_NUDGES=2
MAX_DOC_REREQUESTS=2
MAX_MESSAGES_PER_DAY=3

# Guardrails
SENTIMENT_ESCALATE_THRESHOLD=-0.5
MIN_PLANNER_CONFIDENCE=0.6

# Policy retrieval
POLICY_BM25_THRESHOLD=0.1
POLICY_TOP_K=3

# Visit scheduling
VISIT_NEARBY_RADIUS_KM=2.0
VISIT_SLOT_DURATION_MINUTES=45
VISIT_START_HOUR=11

# Prompt versioning
PROMPT_VERSION=v1
